# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

NEXT_PUBLIC_SITE_URL=https://oliveandverse.com

# Stripe (Olive and Verse account) > Developers > API keys
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
# Stripe > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true only after turning on Stripe Tax
STRIPE_AUTOMATIC_TAX=false

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend > API Keys (domain oliveandverse.com must be verified)
RESEND_API_KEY=re_...
EMAIL_FROM=Olive and Verse <hello@oliveandverse.com>
# Optional: Resend segment ID for the newsletter list
RESEND_SEGMENT_ID=
